rules_version = '2';
// Regras de segurança do app Coleta de Água.
// E-mail do administrador principal: gustavo.s.almeida@gmail.com (o mesmo do index.html).
//
// Resumo das permissões:
// - Administradores: cadastram usuários, hospitais e o cronograma de coletas.
// - Usuários: veem tudo e NÃO alteram nenhum cadastro (usuários, hospitais, máquinas, cronograma).
//   Só atualizam o andamento das coletas (status, data, responsável, resultado, laudo, observações).
// - Só entra quem tem o e-mail cadastrado por um administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function hasDoc() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function isOwnerEmail() { return verified() && myEmail() in ['gustavo.s.almeida@gmail.com']; }
    function isAdmin() {
      return isOwnerEmail() || (signedIn() && hasDoc() && me().aprovado == true && me().papel == 'admin');
    }
    function approved() {
      return isOwnerEmail() || (signedIn() && hasDoc() && me().aprovado == true);
    }
    function conviteExiste() { return exists(/databases/$(database)/documents/convites/$(myEmail())); }
    function convite() { return get(/databases/$(database)/documents/convites/$(myEmail())).data; }

    // Cadastros feitos pelo administrador (aguardando o primeiro acesso da pessoa).
    // O id do documento é o e-mail da pessoa em minúsculas.
    match /convites/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (verified() && myEmail() == email);
    }

    // Usuários ativos. Só é criado no primeiro acesso de quem tem cadastro do administrador
    // (ou do administrador principal). A pessoa pode editar nome/telefone, mas não a permissão.
    match /usuarios/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.aprovado == true && (
        isOwnerEmail()
        || (verified() && conviteExiste()
            && request.resource.data.papel == convite().papel
            && request.resource.data.email == myEmail())
      );
      // Só administradores alteram cadastros de usuários. A única exceção é automática: no login,
      // quem foi (re)cadastrado pelo administrador recebe a função, o hospital e a permissão desse cadastro.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && verified() && conviteExiste()
            && request.resource.data.aprovado == true
            && request.resource.data.papel == convite().papel
            && request.resource.data.email == myEmail());
      allow delete: if isAdmin();
    }

    // Hospitais: todos os usuários veem; só administradores cadastram, editam e excluem.
    match /hospitais/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // Máquinas (hemodiálise e osmose): todos os usuários veem; só administradores cadastram, editam e excluem.
    match /maquinas/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // Cronograma anual (formato Humaniza): todos veem; só administradores criam e alteram.
    match /cronogramas/{ano} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // Cronograma de coletas: só administradores criam e excluem;
    // usuários atualizam o andamento, sem mudar hospital, mês ou ano.
    match /coletas/{id} {
      allow read: if approved();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (approved()
        && request.resource.data.hospitalId == resource.data.hospitalId
        && request.resource.data.mes == resource.data.mes
        && request.resource.data.ano == resource.data.ano
        && request.resource.data.get('linhaId', '') == resource.data.get('linhaId', '')
        && request.resource.data.get('tipoColeta', '') == resource.data.get('tipoColeta', ''));
    }
  }
}
