rules_version = '2';
// Regras de segurança do app Coleta de Água.
// TROQUE "seuemail@gmail.com" pelo e-mail do administrador (o mesmo do index.html).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasDoc() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email in ['gustavo.s.almeida@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isOwnerEmail() || (signedIn() && hasDoc() && me().aprovado == true && me().papel == 'admin');
    }
    function approved() {
      return isOwnerEmail() || (signedIn() && hasDoc() && me().aprovado == true);
    }

    // Cadastro de usuários: cada um cria o próprio (sempre como "não aprovado");
    // só o administrador aprova, muda permissões ou remove.
    match /usuarios/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.aprovado == false
        && request.resource.data.papel == 'membro';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.aprovado == resource.data.aprovado
            && request.resource.data.papel == resource.data.papel);
      allow delete: if isAdmin();
    }

    // Hospitais e coletas: só usuários aprovados.
    match /hospitais/{id} {
      allow read, write: if approved();
    }
    match /coletas/{id} {
      allow read, write: if approved();
    }
  }
}
